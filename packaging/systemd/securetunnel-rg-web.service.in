# Design input only: the independent Web daemon and notify protocol are not implemented.
# The installer must validate the daemon, accounts, directories and UDS access before enable.
[Unit]
Description=SecureTunnelRG Web Management
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=securetunnel-rg-web
Group=securetunnel-rg-web
SupplementaryGroups=securetunnel-rg-management securetunnel-rg-approval
ExecStart=/usr/libexec/securetunnel-rg/securetunnel-rg-web serve --config /etc/securetunnel-rg/web.toml
Restart=always
RestartSec=5s
RestartSteps=6
RestartMaxDelaySec=60s
TimeoutStartSec=30s
TimeoutStopSec=15s
TimeoutAbortSec=5s
WatchdogSec=30s
KillMode=control-group
StateDirectory=securetunnel-rg/web
StateDirectoryMode=0700
RuntimeDirectory=securetunnel-rg/web
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
TasksMax=64
MemoryHigh=96M
MemoryMax=128M
LimitNOFILE=1024
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=securetunnel-rg-web

[Install]
WantedBy=multi-user.target
